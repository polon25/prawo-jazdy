# Copy to .env and adjust; every setting is optional.

# Where the web page listens.
WEB_HOST=0.0.0.0
WEB_PORT=8073

# Downloads, converted media and the question database (default: ./data).
#DATA_DIR=/srv/prawo-jazdy

# ffmpeg to convert media with (default: ffmpeg on PATH, else the one
# from imageio-ffmpeg), and how many files to convert at once (default:
# number of CPUs).
#FFMPEG=/usr/bin/ffmpeg
#MEDIA_WORKERS=4
